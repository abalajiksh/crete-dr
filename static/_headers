# Cloudflare Pages header rules.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# SvelteKit fingerprints everything under _app/immutable, so it can be cached
# forever — a change ships under a new filename.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Font files are content-stable; a new cut ships under a new filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
